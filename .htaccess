# Apache HTTP Server Cache Configuration for Vistaraz

<IfModule mod_headers.c>
  # 1. Content-hashed static assets in assets/dist/ (1 year cache, immutable)
  <FilesMatch "^.+\.[a-f0-9]{8}\.(css|js|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Explicitly for assets/dist/ folder
  <If "%{REQUEST_URI} =~ m#^/assets/dist/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # 2. HTML files (Revalidate every request for instant cache invalidation)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # 3. Unversioned static assets fallback (revalidate daily)
  <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|js|css|swf)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# Custom Error Documents
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

