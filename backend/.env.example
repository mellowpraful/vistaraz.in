# ─── Server ───────────────────────────────────────────────────────────────────
# Port the backend server listens on
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example: http://localhost:3000,https://vistaraz.in
CORS_ORIGINS=http://localhost:3000

# ─── NeonDB (PostgreSQL) ─────────────────────────────────────────────────────
# Neon Serverless PostgreSQL connection string (pooled or direct)
# Example: postgresql://neondb_owner:npg_xxxx@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:<YOUR_PASSWORD>@<YOUR_NEON_HOST>/neondb?sslmode=require

# ─── Better Auth ─── Add in Phase 3 ──────────────────────────────────────────
# BETTER_AUTH_SECRET=your-32-char-secret-here
# BETTER_AUTH_URL=http://localhost:5000

